# ---------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# Leave the Google values empty to run on the built-in fictional data.
# ---------------------------------------------------------------

# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_ID=

# From the service account JSON key file ("client_email")
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the same JSON file ("private_key"). Keep the quotes and the \n sequences exactly as they are.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: set to "memory" to ignore the sheet and use fictional data
# DATA_SOURCE=memory

# ---------------------------------------------------------------
# Optional: reminder emails sent from the app (https://resend.com, free tier).
# Without these, "Open in my email" still drafts reminders in HR's own mail app.
# NOTIFY_FROM must use a domain verified in Resend, e.g. "C&B HR <hr@candbindia.com>".
# ---------------------------------------------------------------
RESEND_API_KEY=
NOTIFY_FROM=
